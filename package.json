{
  "name": "reels-factory",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "ReelsMaker: локальная монтажная вертикальных роликов — расшифровка, реплики, агент-монтажёр (Claude Code), несколько вариантов из одного сюжета",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "node --import tsx packages/core/src/cli-migrate.ts",
    "ui": "node --import tsx apps/hub/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
