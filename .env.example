# Копия этого файла — .env (в git не идёт). Пустое значение = «не задано».
# Каталог данных: папки входа и вывода, оформление (style.json), свои шрифты (fonts/). Обязательно.
RF_DATA_DIR=C:/ReelsMaker
# Папка входа (в ней папки сюжетов) и папка готовых роликов. Пусто = <RF_DATA_DIR>/inbox и <RF_DATA_DIR>/out
RF_INBOX_DIR=
RF_OUTPUT_DIR=
# Программы. Пусто = взять из PATH под именем ffmpeg / ffprobe.
RF_FFMPEG_PATH=
RF_FFPROBE_PATH=
# Расшифровка речи — faster-whisper (см. README, раздел «Расшифровка»).
# Python окружения, где установлен faster-whisper, и каталог модели (например, faster-whisper-large-v3-turbo).
# Пусто = без расшифровки (ролики без субтитров).
RF_STT_PYTHON=
RF_STT_MODEL=
# Кодировщик по умолчанию: nvenc (видеокарта NVIDIA) или cpu (libx264). Пусто = cpu
RF_HW=cpu
# Адрес локального интерфейса. Пусто = http://127.0.0.1:8787
RF_HUB_URL=
# HTTP(S)-прокси для агента-монтажёра к Anthropic, например http://127.0.0.1:3128. Пусто = напрямую.
RF_AGENT_PROXY=
# Часовой пояс для показа времени в интерфейсе. Пусто = Europe/Moscow.
RF_TIMEZONE=
